{
  "name": "duel-atelier",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/verify-art.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:art": "node scripts/verify-art.mjs",
    "check": "node scripts/verify-art.mjs && tsc --noEmit && vitest run && vite build",
    "server": "tsx server/main.ts",
    "benchmark:online": "tsx scripts/benchmark-online.ts",
    "host:lan": "tsx server/host.ts",
    "host:public": "tsx server/host.ts --public"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
